# ぬりログ 環境変数のサンプル
# 本番(クラウド)デプロイ(Cloudflare Pages 等)のビルド環境変数に設定する。
# ローカルで本番接続を試す場合は、これらを指定して `node scripts/gen-config.mjs` を実行する。
#
# 値が未設定なら自動的に「デモ(端末内保存)モード」で動作する。

# Supabase プロジェクトURL（例: https://xxxx.supabase.co）
SUPABASE_URL=

# Supabase anon public キー（クライアント公開前提・RLSで保護される公開キー）
SUPABASE_ANON_KEY=

# ─────────────────────────────────────────────
# ⚠️ service_role キーは絶対にここへ書かない／フロントへ載せない／コミットしない。
#    全権限でRLSを無視するため、サーバー側の管理操作でのみ厳重に扱うこと。
# ─────────────────────────────────────────────
